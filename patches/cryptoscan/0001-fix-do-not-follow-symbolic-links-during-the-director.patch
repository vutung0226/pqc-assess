From c01771d979f998ba9b7557ceb91736f8482479e4 Mon Sep 17 00:00:00 2001
From: Tung <vuchauduytung@gmail.com>
Date: Mon, 2 Nov 2026 15:23:36 +0700
Subject: [PATCH 1/2] fix: do not follow symbolic links during the directory
 walk

A link in the scanned tree could point at a file outside it, such as
~/.ssh/id_rsa, and the report then copied that file's lines. Links are
now listed in skippedFiles with their own reason instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/reporter/text.go        | 11 +++--
 pkg/scanner/scanner.go      | 23 +++++++++-
 pkg/scanner/symlink_test.go | 92 +++++++++++++++++++++++++++++++++++++
 3 files changed, 121 insertions(+), 5 deletions(-)
 create mode 100644 pkg/scanner/symlink_test.go

diff --git a/pkg/reporter/text.go b/pkg/reporter/text.go
index b8ed202..d8dbe85 100644
--- a/pkg/reporter/text.go
+++ b/pkg/reporter/text.go
@@ -610,8 +610,8 @@ func (r *TextReporter) generateGroupedByFile(results *scanner.Results, b *string
 const maxSkippedListed = 10
 
 // writeSkippedFiles names the files the scan left out as minified or
-// generated, as dependency manifests it has no reader for, or as reports
-// CryptoScan wrote, and why.
+// generated, as dependency manifests it has no reader for, as reports
+// CryptoScan wrote, or as symbolic links, and why.
 func (r *TextReporter) writeSkippedFiles(b *strings.Builder, files []scanner.SkippedFile) {
 	b.WriteString(r.color(colorYellow, fmt.Sprintf(
 		"\n  %d file(s) were not scanned, so cryptography in them is not in this report:\n",
@@ -623,9 +623,11 @@ func (r *TextReporter) writeSkippedFiles(b *strings.Builder, files []scanner.Ski
 		}
 		fmt.Fprintf(b, "    %s  %s\n", sk.File, sk.Reason)
 	}
-	minified, manifests, reports, recognized := false, false, false, false
+	minified, manifests, reports, recognized, symlinks := false, false, false, false, false
 	for _, sk := range files {
 		switch {
+		case sk.IsSymlink():
+			symlinks = true
 		case sk.IsUnreadManifest():
 			manifests = true
 		case sk.IsCryptoScanReport():
@@ -647,6 +649,9 @@ func (r *TextReporter) writeSkippedFiles(b *strings.Builder, files []scanner.Ski
 	if recognized {
 		b.WriteString("  " + IncludeReportsHint + "\n")
 	}
+	if symlinks {
+		b.WriteString("  To scan what a symbolic link points to, scan that file or folder as its own target.\n")
+	}
 }
 
 // writeSkippedDependencyDirs names the node_modules directories the scan did
diff --git a/pkg/scanner/scanner.go b/pkg/scanner/scanner.go
index 9c6cee1..58ccbb5 100644
--- a/pkg/scanner/scanner.go
+++ b/pkg/scanner/scanner.go
@@ -267,8 +267,8 @@ func (u UnanalyzedFile) IsInternalError() bool {
 
 // SkippedFile is a file the scanner did not search for cryptography because
 // its name or its line lengths mark it as minified or generated code, because
-// it is a dependency manifest the scanner has no reader for, or because it is
-// a report CryptoScan wrote.
+// it is a dependency manifest the scanner has no reader for, because it is a
+// report CryptoScan wrote, or because it is a symbolic link.
 type SkippedFile struct {
 	File   string `json:"file"`
 	Reason string `json:"reason"`
@@ -311,6 +311,19 @@ func (sk SkippedFile) IsUnreadManifest() bool {
 	return sk.Reason == unreadManifestReason
 }
 
+// symlinkReason is the Reason of a symbolic link the walk reached. The link
+// is not followed: it can point outside the scanned tree, at a file such as
+// ~/.ssh/id_rsa, and the report would then copy that file's lines. A link to
+// a file inside the tree loses nothing, since the walk reaches that file
+// itself.
+const symlinkReason = "symbolic link: not followed, so that it cannot lead the scan to a file outside the scanned folder"
+
+// IsSymlink reports whether the file was skipped because it is a symbolic
+// link.
+func (sk SkippedFile) IsSymlink() bool {
+	return sk.Reason == symlinkReason
+}
+
 // IsCryptoScanReport reports whether the file was skipped because it is a
 // report CryptoScan wrote, or the file the scan's own report replaces.
 func (sk SkippedFile) IsCryptoScanReport() bool {
@@ -813,6 +826,12 @@ func (s *Scanner) scanDirectory(root string) error {
 			}
 			return nil
 		}
+		// Checked before shouldScanFile, which opens the file to test
+		// whether it is binary, so that the link's target is never opened.
+		if d.Type()&fs.ModeSymlink != 0 {
+			s.skip(path, symlinkReason)
+			return nil
+		}
 		if s.shouldScanFile(root, path) {
 			filesToScan = append(filesToScan, path)
 		}
diff --git a/pkg/scanner/symlink_test.go b/pkg/scanner/symlink_test.go
new file mode 100644
index 0000000..02723c4
--- /dev/null
+++ b/pkg/scanner/symlink_test.go
@@ -0,0 +1,92 @@
+// Copyright 2025-2026 CyberSecurity NonProfit (CSNP)
+// SPDX-License-Identifier: Apache-2.0
+
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// A symbolic link in the scanned tree must not lead the scan to a file
+// outside it. A repository can hold a link named like source, such as
+// innocent.py pointing at ~/.ssh/id_rsa, and the report copies the matched
+// line and the lines around it, so following the link would put the user's
+// key in a report that may be uploaded where the repository's author reads it.
+func TestScanDoesNotFollowSymlinks(t *testing.T) {
+	outside := t.TempDir()
+	const secret = "TOP_SECRET_TOKEN_outside_the_tree"
+	key := "-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA" + secret + "\n-----END RSA PRIVATE KEY-----\n"
+	keyFile := filepath.Join(outside, "id_rsa")
+	if err := os.WriteFile(keyFile, []byte(key), 0600); err != nil {
+		t.Fatal(err)
+	}
+	keyDir := filepath.Join(outside, "keys")
+	if err := os.Mkdir(keyDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(keyDir, "server.py"), []byte("hash = md5(data)  # "+secret+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "main.py"), []byte("import hashlib\nh = hashlib.md5(data)\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	fileLink := filepath.Join(root, "innocent.py")
+	dirLink := filepath.Join(root, "lib")
+	if err := os.Symlink(keyFile, fileLink); err != nil {
+		t.Skipf("cannot create a symbolic link here: %v", err)
+	}
+	if err := os.Symlink(keyDir, dirLink); err != nil {
+		t.Skipf("cannot create a symbolic link here: %v", err)
+	}
+
+	// Three lines of context, as the CLI keeps by default, so that the
+	// secret on the line between the key's two markers is in a finding's
+	// SourceContext if the link is followed.
+	results, err := New(Config{Target: root, MinSeverity: SeverityInfo, ContextLines: 3}).Scan()
+	if err != nil {
+		t.Fatalf("Scan failed: %v", err)
+	}
+
+	if results.FilesScanned != 1 {
+		t.Errorf("FilesScanned = %d, want 1: main.py, and neither link", results.FilesScanned)
+	}
+	foundMain := false
+	for _, f := range results.Findings {
+		if filepath.Base(f.File) == "main.py" {
+			foundMain = true
+			continue
+		}
+		t.Errorf("finding %s in %s, which the scan reached through a symbolic link", f.ID, f.File)
+	}
+	if !foundMain {
+		t.Error("no finding in main.py; the regular file next to the links should still be scanned")
+	}
+	for _, f := range results.Findings {
+		text := f.Match + f.Context
+		if f.SourceContext != nil {
+			for _, line := range f.SourceContext.Lines {
+				text += line.Content
+			}
+		}
+		if strings.Contains(text, secret) {
+			t.Errorf("finding %s in %s copies the content of a file outside the scanned folder", f.ID, f.File)
+		}
+	}
+
+	skipped := make(map[string]bool)
+	for _, sk := range results.SkippedFiles {
+		if sk.IsSymlink() {
+			skipped[sk.File] = true
+		}
+	}
+	for _, link := range []string{fileLink, dirLink} {
+		if !skipped[link] {
+			t.Errorf("SkippedFiles = %+v, want %s listed as a symbolic link", results.SkippedFiles, link)
+		}
+	}
+}
